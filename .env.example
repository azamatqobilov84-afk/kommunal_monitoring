# Bu fayl namuna — production muhitda kerakli o'zgaruvchilar
# Mahalliy ishga tushirish uchun KERAK EMAS — Django o'z-o'zidan ishlaydi

# Universal — har 3 platformada kerak
DJANGO_SECRET_KEY=bu-yerga-50-belgili-tasodifiy-satr-yozing

# Render.com — avtomatik beriladi (qo'lda yozish kerak emas)
# RENDER=True
# RENDER_EXTERNAL_HOSTNAME=kommunal-monitoring.onrender.com
# DATABASE_URL=postgresql://...

# Fly.io — avtomatik beriladi
# FLY_APP_NAME=kommunal-monitoring

# Railway — avtomatik beriladi, lekin RAILWAY_PUBLIC_DOMAIN ni qo'lda kiritish kerak
# RAILWAY_PROJECT_ID=auto
# RAILWAY_PUBLIC_DOMAIN=kommunal-monitoring.up.railway.app
# DATABASE_URL=postgresql://...

# Custom domeningiz bo'lsa (har 3 platformada):
# CUSTOM_DOMAIN=kommunal.uz
